          "text": [
            "Test RMSE: 1.7816\n"
          ]
        }
      ],
      "source": [
        "from sklearn import metrics\n",
        "\n",
        "rmse = np.sqrt(metrics.mean_squared_error(y_test, y_pred))\n",
        "print(\"Test RMSE:\", round(rmse, 4))\n"
      ]
    },
