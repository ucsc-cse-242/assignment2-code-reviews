        "execution": {
          "iopub.execute_input": "2026-10-22T05:16:44.029171Z",
          "iopub.status.busy": "2026-10-22T05:16:44.029039Z",
          "iopub.status.idle": "2026-10-22T05:16:44.519581Z",
          "shell.execute_reply": "2026-10-22T05:16:44.519193Z"
        },
        "colab": {
